{
  "app": "npx ts-node --prefer-ts-exts index.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk.context.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package.json",
      "package-lock.json",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-sns-subscriptions:restrictSqsDescryption": true,
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:specifiedBucketNames": true,
    "@aws-cdk/aws-ec2:launchTemplateDefaultUserData": true,
    "@aws-cdk/aws-iam:standardizedServicePrincipals": true,
    "@aws-cdk/aws-utils:loadLucentStyles": true,
    "@aws-cdk/aws-codepipeline:crossAccountKeys": true,
    "@aws-cdk/aws-s3:stepFunctionsDefaultEncryption": true,
    "@aws-cdk/aws-kms:aliasNameRef": true,
    "@aws-cdk/aws-autoscaling-common:optInPtrHolderCorrection": true,
    "@aws-cdk/aws-lambda-event-sources:kafkaEventSourcePropsApiV2": true,
    "@aws-cdk/aws-ec2:uniqueImdsRequirementName": true,
    "@aws-cdk/aws-s3:keepNotificationCloudFormationInterfaceDistinct": true,
    "@aws-cdk/aws-iam:canUseCertificateWithNoPrincipal": true,
    "@aws-cdk/aws-codepipeline:crossAccountKeyAliasStackSafeResourceName": true
  }
}
