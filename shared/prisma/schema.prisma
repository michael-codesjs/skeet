generator be_main {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  output = "../../services/main/src/generated/prisma_client"
}

generator nexus_prisma {
  provider = "nexus-prisma"
  output = "../../services/main/src/generated/nexus-prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  profilePictureKey String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  phoneNumber   String?   @unique
  
  sessions      Session[]
  accounts      Account[]
  
  projects      Project[]
  media         Media[]

  @@map("user")

}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  activeOrganizationId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

enum FileStatus {
  UPLOADING
  READY
  PROCESSING
  FAILED
  DRAFT_READY
}

model Media {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  // S3 Information
  s3Key        String     @unique // The actual path in S3 (e.g., "uploads/user123/clip.mp4")
  bucket       String
  fileName     String     // Original filename (e.g., "IMG_4920.MOV")
  mimeType     String     
  size         Int        // In bytes
  duration     Float?     // Duration in seconds (filled by the Agent later)
  thumbnailUrl String?    // URL to the generated thumbnail
  proxyUrl     String?    // URL to low-res video proxy (720p)

  // AI Analysis (The "Watch" Data)
  status       FileStatus @default(UPLOADING)
  tags         String[]   // e.g., ["sunset", "shaky", "action"]
  summary      String?    // AI-generated description of what happens in this clip
  shotBreakdown Json?     // Array of { timestamp: number, description: string }

  // Job Completion Flags
  thumbnailReady Boolean  @default(false)
  analysisReady  Boolean  @default(false)

  // Relationships
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  projectId    String?    // Link to the final edit this clip belongs to
  project      Project?   @relation(fields: [projectId], references: [id])
  
  // Lineage (For derived assets like audio/video streams)
  parentMediaId String?
  parentMedia   Media?    @relation("MediaLineage", fields: [parentMediaId], references: [id])
  derivedMedia  Media[]   @relation("MediaLineage")

  @@map("media")
}

model Project {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  title        String?
  description       String
  finalS3Key   String?     @unique // Path to the finished rendered video
  status       FileStatus  @default(PROCESSING)

  otio     Json? 

  // Relationships
  media        Media[]
  userId       String
  user         User        @relation(fields: [userId], references: [id])

  @@map("project")
}